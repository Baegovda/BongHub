<Window x:Class="BongHub.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BongHub"
        Title="스티커 메모" Width="330" Height="330"
        MinWidth="{x:Static local:StickyNoteWindow.NoteMinWidth}" MinHeight="{x:Static local:StickyNoteWindow.NoteMinHeight}"
        MaxWidth="{x:Static local:StickyNoteWindow.NoteMaxWidth}" MaxHeight="{x:Static local:StickyNoteWindow.NoteMaxHeight}"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid x:Name="Root" TextElement.Foreground="#F0F0F6" TextElement.FontFamily="{StaticResource UiFont}">
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- soft top sheen, like an iOS widget -->
    <Border Grid.RowSpan="3" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#16FFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="0.35"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <!-- top bar: native caption (drag). The title sits with the tools, like a page name. -->
    <Grid Grid.Row="0" Margin="14,0,6,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
        <TextBlock x:Name="TitleHint" Text="제목" FontWeight="Bold" Opacity="0.38" IsHitTestVisible="False" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBox x:Name="TitleBox" FontWeight="Bold" Background="Transparent" BorderThickness="0" Padding="0" BorderBrush="Transparent"
                 MaxLength="80" VerticalContentAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"
                 WindowChrome.IsHitTestVisibleInChrome="True"/>
      </Grid>
      <StackPanel x:Name="Bar" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="1">
        <Button x:Name="NewBtn" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="새 메모" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="FontBtn" Style="{StaticResource IconButton}" Content="&#xE8D2;" ToolTip="서식" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="ColorBtn" Style="{StaticResource IconButton}" Content="&#xE790;" ToolTip="색" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="ListBtn" Style="{StaticResource IconButton}" Content="&#xE700;" ToolTip="메모 목록" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="PinBtn" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="항상 위" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" ToolTip="닫기" WindowChrome.IsHitTestVisibleInChrome="True"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="EditorHost" Grid.Row="1" Margin="10,8,8,4">
      <!-- Idle notes stay on this viewer. A RichTextBox is created only while the note is being edited. -->
      <FlowDocumentScrollViewer x:Name="Viewer" Background="Transparent" BorderThickness="0"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                IsToolBarVisible="False" Focusable="False" FontFamily="{StaticResource UiFont}">
        <FlowDocumentScrollViewer.Resources>
          <Style TargetType="Paragraph"><Setter Property="Margin" Value="0,0,0,2"/></Style>
        </FlowDocumentScrollViewer.Resources>
      </FlowDocumentScrollViewer>
      <TextBlock x:Name="Hint" Margin="4,0,0,0" Text="메모를 입력하세요" Opacity="0.45" IsHitTestVisible="False" FontSize="14"/>
      <TextBlock x:Name="LargeWarn" VerticalAlignment="Bottom" Margin="4" Padding="8,4" TextWrapping="Wrap"
                 Background="#CC3A2418" Foreground="#F5D7A1" FontSize="12" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>

    <!-- format bar (iOS-style floating capsule) -->
    <Border x:Name="FormatBar" Grid.Row="2" Margin="10,0,10,10" CornerRadius="14" Background="#33000000" BorderBrush="#1FFFFFFF" BorderThickness="1"
            Padding="4,2" HorizontalAlignment="Left" Visibility="Collapsed" Opacity="0">
      <Border.RenderTransform><TranslateTransform x:Name="FormatShift" Y="8"/></Border.RenderTransform>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BoldBtn" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}" FontWeight="Bold" FontSize="14" Content="B" ToolTip="굵게 (Ctrl+B)"/>
        <Button x:Name="ItalicBtn" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}" FontStyle="Italic" FontSize="14" Content="I" ToolTip="기울임 (Ctrl+I)"/>
        <Button x:Name="UnderBtn" Style="{StaticResource IconButton}" FontSize="14" ToolTip="밑줄 (Ctrl+U)"><TextBlock Text="U" TextDecorations="Underline" FontFamily="{StaticResource UiFont}"/></Button>
        <Button x:Name="StrikeBtn" Style="{StaticResource IconButton}" FontSize="14" ToolTip="취소선"><TextBlock Text="S" TextDecorations="Strikethrough" FontFamily="{StaticResource UiFont}"/></Button>
        <Button x:Name="BulletBtn" Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="글머리 기호 (Ctrl+Shift+L)"/>
        <Button x:Name="SizeBtn" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}" FontWeight="Bold" FontSize="13" Content="Aa" ToolTip="텍스트 · 제목"/>
        <Button x:Name="SmallerBtn" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}" FontSize="12" Content="A−" ToolTip="글자 작게 (Ctrl+-)" />
        <Button x:Name="LargerBtn" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}" FontSize="12" Content="A+" ToolTip="글자 크게 (Ctrl++)" />
        <Button x:Name="ResetSizeBtn" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="기본 글자 크기"/>
        <Button x:Name="ImageBtn" Style="{StaticResource IconButton}" Content="&#xE91B;" ToolTip="이미지 넣기"/>
      </StackPanel>
    </Border>

    <!-- color palette popup -->
    <Popup x:Name="Palette" PlacementTarget="{Binding ElementName=ColorBtn}" Placement="Bottom" HorizontalOffset="-150" VerticalOffset="6"
           AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
      <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1" CornerRadius="14" Padding="10" Width="280">
        <StackPanel>
          <WrapPanel x:Name="Swatches"/>
          <local:CustomColorBar x:Name="CustomColor" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
