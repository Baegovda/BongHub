<Window x:Class="BongHub.Next.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BongHub" Width="980" Height="660" MinWidth="760" MinHeight="500"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid x:Name="Root" TextElement.Foreground="{StaticResource Text}" TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <!-- dark gradient tint (sits on Mica when available, opaque otherwise) -->
    <Border x:Name="Tint" Grid.ColumnSpan="2" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop x:Name="TintA" Color="#0D1018" Offset="0"/>
          <GradientStop x:Name="TintB" Color="#141224" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Ellipse Grid.ColumnSpan="2" Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-180,0" IsHitTestVisible="False" Opacity="0.22">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#4C8AFE" Offset="0"/><GradientStop Color="#004C8AFE" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
    </Ellipse>
    <Ellipse Grid.ColumnSpan="2" Width="440" Height="440" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="120,0,0,-240" IsHitTestVisible="False" Opacity="0.14">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#E47EF4" Offset="0"/><GradientStop Color="#00E47EF4" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
    </Ellipse>

    <!-- ===== sidebar ===== -->
    <Border Grid.Column="0" Background="#59000000" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,0,14,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,18,0,22">
          <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGradient}">
            <Grid Margin="8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <Border Margin="1" CornerRadius="2.5" Background="White"/>
              <Border Grid.Column="1" Margin="1" CornerRadius="2.5" Background="#CCFFFFFF"/>
              <Border Grid.Row="1" Margin="1" CornerRadius="2.5" Background="#CCFFFFFF"/>
              <Border Grid.Row="1" Grid.Column="1" Margin="1" CornerRadius="2.5" Background="#80FFFFFF"/>
            </Grid>
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="AppTitle" Text="BongHub" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold"/>
            <TextBlock x:Name="AppSub" Text="Next" FontSize="11.5" Foreground="{StaticResource Secondary}"/>
          </StackPanel>
        </StackPanel>
        <Border x:Name="StatusPill" DockPanel.Dock="Bottom" CornerRadius="12" Background="#1AFFFFFF" Padding="12,9">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#34C759" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Margin="9,0,0,0" FontSize="12" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" MaxWidth="180"/>
          </StackPanel>
        </Border>
        <Grid x:Name="NavHost" VerticalAlignment="Top">
          <Border x:Name="NavSel" Height="40" VerticalAlignment="Top" CornerRadius="11" Background="#24FFFFFF">
            <Border.RenderTransform><TranslateTransform x:Name="NavSelT"/></Border.RenderTransform>
          </Border>
          <StackPanel x:Name="Nav"/>
        </Grid>
      </DockPanel>
    </Border>

    <!-- ===== content ===== -->
    <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,44,0,0" Focusable="False">
      <StackPanel x:Name="PageHost" Margin="36,0,40,36" MaxWidth="720" HorizontalAlignment="Stretch"/>
    </ScrollViewer>

    <!-- caption buttons -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
      <Button x:Name="MinBtn" Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="10" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="최소화"/>
      <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" Margin="4,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="닫기 (트레이에서 계속 실행)"/>
    </StackPanel>
  </Grid>
</Window>
