<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BongHub.Next</AssemblyName>
    <RootNamespace>BongHub.Next</RootNamespace>
    <ApplicationIcon>..\..\app\res\icon_blocks.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.0</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <Product>BongHub Next</Product>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**</DefaultItemExcludes>
    <!-- WPF needs the PerMonitorV2 manifest; WFAC010 only applies to WinForms Application.Run, which this app never calls -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
</Project>
